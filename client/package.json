{
  "name": "@uwmadison-chm/pig-client",
  "version": "1.0.0-pre.3",
  "description": "Send a task's data to Psych Ingestor (Pig), durably, online or off.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwmadison-chm/psych-ingestor.git",
    "directory": "client"
  },
  "homepage": "https://github.com/uwmadison-chm/psych-ingestor/tree/main/client#readme",
  "bugs": "https://github.com/uwmadison-chm/psych-ingestor/issues",
  "keywords": [
    "psychology",
    "behavioral-research",
    "experiment",
    "data-collection",
    "psych-ingestor"
  ],
  "type": "module",
  "main": "./dist/pig.js",
  "module": "./dist/pig.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/pig.js"
    },
    "./pig-worker.js": "./dist/pig-worker.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.js && tsc -p tsconfig.types.json",
    "check": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "fuzz": "node --test fuzz/*.test.ts",
    "e2e": "npm run build && playwright test",
    "benchmark": "node scripts/build-benchmark.js",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "age-encryption": "0.3.1"
  }
}
