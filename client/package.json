{
  "name": "psych-ingestor-client",
  "version": "0.2.0",
  "description": "Send a task's data to Psych Ingestor (Pig), durably, online or off.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/pig.js",
  "module": "./dist/pig.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/pig.js"
    },
    "./pig-worker.js": "./dist/pig-worker.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.js && tsc -p tsconfig.types.json",
    "check": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
